{
  "name": "thorium-frontend",
  "description": "Web UI for Thorium 1.x",
  "type": "module",
  "private": true,
  "version": "1.8.1",
  "scripts": {
    "lint": "node_modules/eslint/bin/eslint.js src",
    "fix": "node_modules/eslint/bin/eslint.js src --fix",
    "build": "tsc -p tsconfig.prod.json && vite build --mode production",
    "build-check": "tsc -p tsconfig.json && vite build --mode production",
    "build-preview": "vite build --mode preview",
    "dev": "vite",
    "format": "prettier src --write",
    "validate-style": "prettier src --check",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "npx playwright test",
    "test:e2e:headed": "npx playwright test --headed"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cisagov/thorium.git`"
  },
  "bugs": {
    "url": "https://github.com/cisagov/thorium/issues"
  },
  "dependencies": {
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-cpp": "^6.0.3",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-yaml": "^6.1.3",
    "@codemirror/language": "^6.13.1",
    "@codemirror/legacy-modes": "^6.5.5",
    "@codemirror/lint": "^6.9.7",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "@headless-tree/core": "^1.8.0",
    "@headless-tree/react": "^1.8.0",
    "@tanstack/react-query": "^5.104.5",
    "@visx/axis": "^4.0.0",
    "@visx/group": "^4.0.0",
    "@visx/scale": "^4.0.0",
    "@visx/shape": "^4.0.0",
    "@xyflow/react": "^12.12.0",
    "3d-force-graph": "^1.80.1",
    "axios": "^1.20.0",
    "bootstrap": "^5.3.8",
    "core-js": "^3.51.0",
    "country-list": "^2.4.1",
    "date-fns": "^4.4.0",
    "diff": "^9.0.0",
    "dompurify": "^3.4.17",
    "html-react-parser": "^6.1.9",
    "is-ip": "^5.0.1",
    "json-bigint": "^1.0.0",
    "jszip": "^3.10.2",
    "react": "^19.3.1",
    "react-bootstrap": "^2.10.10",
    "react-datepicker": "^9.1.0",
    "react-diff-viewer-continued": "^4.4.0",
    "react-dom": "^19.3.1",
    "react-dropzone": "^20.1.4",
    "react-error-boundary": "^6.1.6",
    "react-icons": "^5.7.0",
    "react-intersection-observer": "^11.0.1",
    "react-json-tree": "^0.20.0",
    "react-markdown": "^10.1.0",
    "react-router": "^8.5.0",
    "react-router-dom": "^7.18.4",
    "react-select": "^5.10.2",
    "react-syntax-highlighter": "^16.1.2",
    "react-toastify": "^11.1.0",
    "react-xml-viewer": "^3.0.5",
    "remark-gfm": "^4.0.1",
    "styled-components": "^6.6.0",
    "three": "^0.186.1",
    "three-spritetext": "^1.10.0",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
