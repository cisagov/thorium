{
  "name": "binwalk",
  "group": "static",
  "description": "---\n`Binwalk (v3)` is a file extraction (file carving) tool. It is used for identifying and/or extracting files and data that have been embedded inside of other files. It was originally written to analyze firmware files by ReFirmLabs, which was acquired by Microsoft.\n\n---\n##### Usage\n\nUse `binwalk` on any sample with suspected embedded files. Valid target samples may include disk images, archive files, or PCAPs. This tool will not work on samples that have been encrypted. You can see a full list of supported signatures used for extraction here: [https://github.com/ReFirmLabs/binwalk/wiki/Supported-Signatures](https://github.com/ReFirmLabs/binwalk/wiki/Supported-Signatures).\n\n---\n##### Status\n\nBinwalk is actively maintained and the project receives daily updates.\n\n---\n#### Documentation\n\n[https://github.com/ReFirmLabs/binwalk](https://github.com/ReFirmLabs/binwalk)\n\n---\n#### License\n\nMIT License\n\n&nbsp;\n\nCopyright (c) 2024 devttys0\n\n---",
  "scaler": "K8s",
  "image": "",
  "timeout": 600,
  "display_type": "String",
  "spawn_limit": "Unlimited",
  "collect_logs": true,
  "generator": false,
  "resources": {
    "amd_gpu": 0,
    "burstable": {
      "cpu": 0,
      "memory": "0Gi"
    },
    "cpu": 1,
    "ephemeral_storage": "0Gi",
    "memory": "4Gi",
    "nvidia_gpu": 0
  },
  "args": {
    "command": null,
    "commit": null,
    "entrypoint": null,
    "output": "None",
    "output_files": "None",
    "reaction": null,
    "repo": null
  },
  "output_collection": {
    "as_filesystem": false,
    "auto_tag": {},
    "children": "/tmp/thorium/children",
    "files": {
      "entities": "/tmp/thorium/entities.json",
      "names": [],
      "result_files": "/tmp/thorium/result-files",
      "results": "/tmp/thorium/results",
      "tags": "/tmp/thorium/tags"
    },
    "groups": [],
    "handler": "Files"
  },
  "child_filters": {
    "file_extension": [],
    "file_name": [],
    "mime": [],
    "submit_non_matches": false
  },
  "dependencies": {
    "cache": {
      "enabled": true,
      "generic": {
        "kwarg": null,
        "strategy": "Disabled"
      },
      "location": "/tmp/thorium/cache",
      "use_parent_cache": false
    },
    "children": {
      "enabled": false,
      "images": [],
      "kwarg": null,
      "location": "/tmp/thorium/prior-children",
      "strategy": "Paths"
    },
    "ephemeral": {
      "kwarg": null,
      "location": "/tmp/thorium/ephemeral",
      "names": [],
      "strategy": "Paths"
    },
    "repos": {
      "kwarg": null,
      "location": "/tmp/thorium/repos",
      "strategy": "Paths"
    },
    "results": {
      "images": [],
      "kwarg": "None",
      "location": "/tmp/thorium/prior-results",
      "names": [],
      "strategy": "Paths"
    },
    "samples": {
      "kwarg": null,
      "location": "/tmp/thorium/samples",
      "naming": "Sha256",
      "strategy": "Paths"
    },
    "tags": {
      "enabled": false,
      "kwarg": null,
      "location": "/tmp/thorium/prior-tags",
      "strategy": "Paths"
    }
  },
  "env": {},
