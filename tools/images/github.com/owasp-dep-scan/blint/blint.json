{
  "name": "blint",
  "group": "static",
  "description": "---\n`BLint` is a Binary Linter that checks the security properties and capabilities of your executables. It is powered by lief. Since version 2, `blint` can also generate Software Bill-of-Materials (SBOM) for supported binaries.\n\n---\n##### Usage\n\nUse may run `blint` on executables with the following binary formats:\n\n - Android (apk, aab)\n - ELF (GNU, musl)\n - PE (exe, dll)\n - Mach-O (x64, arm64)\n\n---\n##### Status\n\n`BLint` is actively maintained and the project receives monthly updates.\n\n---\n##### Documentation\n\n[https://github.com/owasp-dep-scan/blint](https://github.com/owasp-dep-scan/blint)\n\n---\n##### License\n\nMIT License\n\n&nbsp;\n\nCopyright (c) OWASP Foundation\n\n---",
  "scaler": "K8s",
  "image": "",
  "timeout": 300,
  "display_type": "HTML",
  "spawn_limit": "Unlimited",
  "collect_logs": true,
  "generator": false,
  "resources": {
    "amd_gpu": 0,
    "burstable": {
      "cpu": 0,
      "memory": "0Gi"
    },
    "cpu": 2,
    "ephemeral_storage": "0Gi",
    "memory": "8Gi",
    "nvidia_gpu": 0
  },
  "args": {
    "command": null,
    "commit": null,
    "entrypoint": null,
    "output": "None",
    "output_files": "None",
    "reaction": null,
    "repo": null
  },
  "output_collection": {
    "as_filesystem": false,
    "auto_tag": {},
    "children": "/tmp/thorium/children",
    "files": {
      "entities": "/tmp/thorium/entities.json",
      "names": [],
      "result_files": "/tmp/thorium/result-files",
      "results": "/tmp/thorium/results",
      "tags": "/tmp/thorium/tags"
    },
    "groups": [],
    "handler": "Files"
  },
  "child_filters": {
    "file_extension": [],
    "file_name": [],
    "mime": [],
    "submit_non_matches": false
  },
  "dependencies": {
    "cache": {
      "enabled": true,
      "generic": {
        "kwarg": null,
        "strategy": "Disabled"
      },
      "location": "/tmp/thorium/cache",
      "use_parent_cache": false
    },
    "children": {
      "enabled": false,
      "images": [],
      "kwarg": null,
      "location": "/tmp/thorium/prior-children",
      "strategy": "Paths"
    },
    "ephemeral": {
      "kwarg": null,
      "location": "/tmp/thorium/ephemeral",
      "names": [],
      "strategy": "Paths"
    },
    "repos": {
      "kwarg": null,
      "location": "/tmp/thorium/repos",
      "strategy": "Paths"
    },
    "results": {
      "images": [],
      "kwarg": "None",
      "location": "/tmp/thorium/prior-results",
      "names": [],
      "strategy": "Paths"
    },
    "samples": {
      "kwarg": null,
      "location": "/tmp/thorium/samples",
      "naming": "Sha256",
      "strategy": "Paths"
    },
    "tags": {
      "enabled": false,
      "kwarg": null,
      "location": "/tmp/thorium/prior-tags",
      "strategy": "Paths"
    }
  },
  "env": {},
  "volumes": [],
  "network_policies": [],
  "clean_up": null,
  "kvm": null,
  "security_context": {
    "allow_privilege_escalation": false,
    "group": null,
    "user": null
  }
}