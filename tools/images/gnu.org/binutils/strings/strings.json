{
  "name": "strings",
  "group": "static",
  "description": "Run the linux/binutils `strings` command to identify sequences of printable characters. There are several instantiations of this tool that look for different character encodings:\n\n * `strings`: single-7-bit-byte characters (default)\n * `strings-16be`: 16-bit bigendian\n * `strings-16le`: 16-bit littleendian\n * `strings-32be`: 32-bit bigendian\n * `strings-32le`: 32-bit littleendian",
  "scaler": "K8s",
  "image": "",
  "timeout": 60,
  "display_type": "String",
  "spawn_limit": "Unlimited",
  "collect_logs": true,
  "generator": false,
  "resources": {
    "amd_gpu": 0,
    "burstable": {
      "cpu": 0,
      "memory": "0Gi"
    },
    "cpu": 1,
    "ephemeral_storage": "0Gi",
    "memory": "4Gi",
    "nvidia_gpu": 0
  },
  "args": {
    "command": null,
    "commit": null,
    "entrypoint": null,
    "output": "None",
    "output_files": "None",
    "reaction": null,
    "repo": null
  },
  "output_collection": {
    "as_filesystem": false,
    "auto_tag": {},
    "children": "/tmp/thorium/children",
    "files": {
      "entities": "/tmp/thorium/entities.json",
      "names": [],
      "result_files": "/tmp/thorium/result-files",
      "results": "/tmp/thorium/results",
      "tags": "/tmp/thorium/tags"
    },
    "groups": [],
    "handler": "Files"
  },
  "child_filters": {
    "file_extension": [],
    "file_name": [],
    "mime": [],
    "submit_non_matches": false
  },
  "dependencies": {
    "cache": {
      "enabled": true,
      "generic": {
        "kwarg": null,
        "strategy": "Disabled"
      },
      "location": "/tmp/thorium/cache",
      "use_parent_cache": false
    },
    "children": {
      "enabled": false,
      "images": [],
      "kwarg": null,
      "location": "/tmp/thorium/prior-children",
      "strategy": "Paths"
    },
    "ephemeral": {
      "kwarg": null,
      "location": "/tmp/thorium/ephemeral",
      "names": [],
      "strategy": "Paths"
    },
    "repos": {
      "kwarg": null,
      "location": "/tmp/thorium/repos",
      "strategy": "Paths"
    },
    "results": {
      "images": [],
      "kwarg": "None",
      "location": "/tmp/thorium/prior-results",
      "names": [],
      "strategy": "Paths"
    },
    "samples": {
      "kwarg": null,
      "location": "/tmp/thorium/samples",
      "naming": "Sha256",
      "strategy": "Paths"
    },
    "tags": {
      "enabled": false,
      "kwarg": null,
      "location": "/tmp/thorium/prior-tags",
      "strategy": "Paths"
    }
  },
  "env": {},
  "volumes": [],
