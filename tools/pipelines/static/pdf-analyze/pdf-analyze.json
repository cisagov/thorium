          "Files"
        ]
      }
    },
    "RunOnRFC822": {
      "Tag": {
        "not": {},
        "required": {
          "MIMEType": [
            "message/rfc822"
          ]
        },
        "tag_types": [
          "Files"
        ]
      }
    }
  }
}
