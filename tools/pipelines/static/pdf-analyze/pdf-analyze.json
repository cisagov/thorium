{
  "name": "pdf-analyze",
  "group": "static",
  "order": [
    [
      "pdf2text"
    ]
  ],
  "description": "Analyze PDF files",
  "sla": 640800,
  "triggers": {
    "RunOnPDF": {
      "Tag": {
        "not": {},
        "required": {
          "FileType": [
            "PDF"
          ]
        },
